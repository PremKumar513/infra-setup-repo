{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRDS",
      "Effect": "Deny",
      "Action": "rds:*",
      "Resource": "*"
    },
    {
      "Sid": "DenyCognito",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:*",
        "cognito-identity:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySensitiveS3",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::*patient*",
        "arn:aws:s3:::*patient*/*",
        "arn:aws:s3:::*pii*",
        "arn:aws:s3:::*pii*/*",
        "arn:aws:s3:::*sensitive*",
        "arn:aws:s3:::*sensitive*/*"
      ]
    }
  ]
}
